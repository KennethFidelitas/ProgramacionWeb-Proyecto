@{
    Layout = "_MiniStoreAuthLayout";
    ViewData["Title"] = "Register";
}

<section class="auth-shell auth-shell-register">
    <div class="container">
        <div class="row align-items-center g-0 auth-card-wrap">
            <div class="col-lg-6 order-lg-2">
                <div class="auth-showcase auth-showcase-register">
                    <span class="auth-kicker">Join MiniStore</span>
                    <h1>Create an account that feels premium.</h1>
                    <p>
                        Build your member profile with a polished registration flow that looks native to the storefront.
                    </p>

                    <div class="auth-stat-row">
                        <div class="auth-stat-box">
                            <strong>24/7</strong>
                            <span>Product inspiration</span>
                        </div>
                        <div class="auth-stat-box">
                            <strong>New</strong>
                            <span>Releases every season</span>
                        </div>
                        <div class="auth-stat-box">
                            <strong>Easy</strong>
                            <span>Wishlist and tracking later</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 order-lg-1">
                <div class="auth-form-panel">
                    <div class="auth-form-header">
                        <span class="auth-form-kicker">Start now</span>
                        <h2>Register</h2>
                        <p>Create your visual account experience.</p>
                    </div>

                    <form class="auth-form auth-form-register" action="#" method="post">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="auth-input-group">
                                    <label for="firstName">First name</label>
                                    <input id="firstName" type="text" placeholder="Alex" />
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="auth-input-group">
                                    <label for="lastName">Last name</label>
                                    <input id="lastName" type="text" placeholder="Rivera" />
                                </div>
                            </div>
                        </div>

                        <div class="auth-input-group">
                            <label for="registerEmail">Email address</label>
                            <input id="registerEmail" type="email" placeholder="name@example.com" />
                        </div>

                        <div class="row">
                            <div class="col-sm-6">
                                <div class="auth-input-group">
                                    <label for="registerPassword">Password</label>
                                    <input id="registerPassword" type="password" placeholder="Create password" />
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="auth-input-group">
                                    <label for="confirmPassword">Confirm</label>
                                    <input id="confirmPassword" type="password" placeholder="Repeat password" />
                                </div>
                            </div>
                        </div>

                        <div class="auth-options auth-options-stack">
                            <label class="auth-check">
                                <input type="checkbox" />
                                <span>I agree to the terms and privacy policy.</span>
                            </label>
                            <label class="auth-check">
                                <input type="checkbox" />
                                <span>I want updates about releases and offers.</span>
                            </label>
                        </div>

                        <button type="submit" class="btn btn-medium btn-dark text-uppercase btn-rounded-none auth-submit">
                            Create account
                        </button>
                    </form>

                    <p class="auth-switch">
                        Already have an account?
                        <a href="/Account/Login">Sign in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
