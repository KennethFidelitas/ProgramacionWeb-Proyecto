@{
    Layout = "_MiniStoreAuthLayout";
    ViewData["Title"] = "RecuperarCuenta";
}

<section class="auth-shell">
    <div class="container">
        <div class="row align-items-center g-0 auth-card-wrap">

            @* ── PANEL IZQUIERDO: showcase ── *@
            <div class="col-lg-6">
                <div class="auth-showcase">
                    <span class="auth-kicker">Account recovery</span>
                    <h1>Recover your account in seconds.</h1>
                    <p>
                        Enter your email and we'll send you a secure link to reset
                        your password and get back to shopping right away.
                    </p>

                    <div class="auth-feature-grid">
                        <div class="auth-feature-box">
                            <h3>Secure reset</h3>
                            <p>Your link expires in 30 minutes for your protection.</p>
                        </div>
                        <div class="auth-feature-box">
                            <h3>Quick access</h3>
                            <p>Back to your orders and wishlist in no time.</p>
                        </div>
                    </div>

                    <div class="auth-showcase-panel">
                        <span class="auth-panel-label">Security tip</span>
                        <strong>Never share your reset link</strong>
                        <p>MiniStore will never ask for your password or link via email or chat.</p>
                    </div>
                </div>
            </div>

            @* ── PANEL DERECHO: formulario ── *@
            <div class="col-lg-6">
                <div class="auth-form-panel">
                    <div class="auth-form-header">
                        <span class="auth-form-kicker">Password reset</span>
                        <h2>Forgot your password?</h2>
                        <p>Enter the email linked to your account and we'll send you the recovery link.</p>
                    </div>

                    <form class="auth-form" asp-controller="Account" asp-action="RecuperarCuenta" method="post">
                        @Html.AntiForgeryToken()

                        <div class="auth-input-group">
                            <label for="email">Email address</label>
                            <input id="email"
                                   name="email"
                                   type="email"
                                   placeholder="name@example.com"
                                   required
                                   autocomplete="email" />



                            @* <span asp-validation-for="@("email")" class="text-danger small"></span>*@
                        </div>

                        @* Mensaje de confirmación / error desde TempData
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success mt-2" role="alert">
                                @TempData["SuccessMessage"]
                            </div>
                        }
                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger mt-2" role="alert">
                                @TempData["ErrorMessage"]
                            </div>
                        }
                        *@

                        <button type="submit"
                                class="btn btn-medium btn-dark text-uppercase btn-rounded-none auth-submit">
                            Send reset link
                        </button>
                    </form>

                    <div class="auth-divider"><span>or</span></div>

                    <p class="auth-switch">
                        Remember your password?
                        <a asp-controller="Account" asp-action="Login">Back to login</a>
                    </p>

                    <p class="auth-switch">
                        Don't have an account?
                        <a asp-controller="Account" asp-action="Register">Create one</a>
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>
